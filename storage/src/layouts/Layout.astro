---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
      <header>
        <a href="/"><img src={astroLogo.src} width="115" height="48" alt="Home" /></a>
      </header>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<!-- Global, as they style the content of each page -->
<style is:global>
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px);
  }

  body {
    font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
    color: #111827;
  }

  main {
    max-width: 768px;
    margin: 0 auto;
    padding: 32px 16px 64px;
  }

  header {
    margin-bottom: 24px;
  }

  h1 {
    font-size: 28px;
    margin: 0 0 16px;
  }

  h2 {
    font-size: 20px;
    font-weight: normal;
    margin: 0 0 12px;
  }

  p,
  li {
    color: #4b5563;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.006em;
  }

  a {
    color: #3245ff;
  }

  code {
    background:
      linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
      linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
    border-radius: 6px;
    border: 1px solid transparent;
    padding: 1px 6px;
    font-size: 0.9em;
  }

  pre {
    font-family:
      ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
      monospace;
    font-size: 14px;
    line-height: 1.6;
    overflow: auto;
    margin: 0 0 16px;
    padding: 16px 20px;
    border-radius: 12px;
  }

  pre code {
    background: none;
    border: 0;
    padding: 0;
  }

  .box {
    padding: 16px 20px;
    margin-bottom: 16px;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    border: 1px solid white;
    backdrop-filter: blur(50px);
  }

  blockquote {
    margin: 0 0 16px;
    padding: 8px 16px;
    border-radius: 10px;
    background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
  }

  blockquote p {
    color: white;
    margin: 0;
  }
</style>
