---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Rendered on demand, so the server reads `docs` from SQLite at request time.
export const prerender = false;

// `content: false` leaves out `body` and `rendered`, so the driver only loads the data.
const docs = (await getCollection({ name: 'docs', content: false })).sort(
  (a, b) => a.data.order - b.data.order,
);
const notes = await getCollection({ name: 'notes', content: false });
const posts = await getCollection({ name: 'blog', content: false });
---

<Layout title="Collection storage drivers">
  <h1>Collection storage drivers</h1>

  <section class="box">
    <h2>Docs <code>SQLite</code>, rendered on demand</h2>
    <ul>
      {docs.map((item) => <li><a href={`/docs/${item.id}/`}>{item.data.title}</a></li>)}
    </ul>
  </section>

  <section class="box">
    <h2>Notes <code>JSON files</code>, rendered on demand</h2>
    <ul>
      {notes.map((item) => <li><a href={`/notes/${item.id}/`}>{item.data.title}</a></li>)}
    </ul>
  </section>

  <section class="box">
    <h2>Blog <code>bundled</code>, prerendered</h2>
    <ul>
      {posts.map((item) => <li><a href={`/blog/${item.id}/`}>{item.data.title}</a></li>)}
    </ul>
  </section>
</Layout>
