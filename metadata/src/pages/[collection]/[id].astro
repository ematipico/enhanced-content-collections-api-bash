---
import { getCollection, getEntry, render } from 'astro:content';
import { getDocsCollections } from '../../docs-kit/collections';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const paths = [];
  for (const { name } of await getDocsCollections()) {
    // Only the IDs are needed here. With collection storage drivers, `getCollection({ name, content: false })`
    // would also leave out the content of the entries.
    for (const { id } of await getCollection(name)) {
      paths.push({ params: { collection: name, id }, props: { collection: name, id } });
    }
  }
  return paths;
}

// Each page reads its own entry, instead of receiving it from `getStaticPaths()`
const { collection, id } = Astro.props;
const entry = (await getEntry(collection, id))!;
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <article class="box">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</Layout>
