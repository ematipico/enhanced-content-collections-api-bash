---
import { getLiveCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Live collections are loaded at request time.
export const prerender = false;

const { entries = [] } = await getLiveCollection('releases');
---

<Layout title="Releases">
  <section class="box">
    <h1>Releases</h1>
    <p>A live collection, loaded at request time.</p>
    <ul>{entries.map((release) => <li>{release.id}: {release.data.title}</li>)}</ul>
  </section>
</Layout>
